{
  "manifest_version": 3,
  "name": "优诺本地翻译插件",
  "description": "使用本机 Ollama/Qwen 在 Edge 中原位翻译网页。",
  "version": "0.6.0",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "优诺本地翻译插件", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "options_page": "options.html"
}
